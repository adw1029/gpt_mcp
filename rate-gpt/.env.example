# Feature modules to load (packages under src/rate_gpt/modules)
RATE_GPT_MODULES=applications,status,accounts

# Storage backend: memory (more coming)
RATE_GPT_DATA_BACKEND=memory
RATE_GPT_SEED_DEMO_DATA=true

RATE_GPT_HOST=127.0.0.1
RATE_GPT_PORT=8000

# Extra Host headers to accept, comma-separated (e.g. your ngrok domain)
RATE_GPT_PUBLIC_HOSTS=
